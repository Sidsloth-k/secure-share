# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Configuration (for migrations)
# Option 1: Direct PostgreSQL connection string
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Option 2: Individual database credentials (alternative to DATABASE_URL)
DATABASE_HOST=db.your-project.supabase.co
DATABASE_PASSWORD=your-database-password

# S3-Compatible Storage Configuration (Supabase Storage)
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
S3_REGION=eu-north-1

# Google Drive OAuth (optional, for cloud storage)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Dropbox OAuth (optional, for cloud storage)
DROPBOX_APP_KEY=your-dropbox-app-key
DROPBOX_APP_SECRET=your-dropbox-app-secret

# OneDrive OAuth (optional, for cloud storage)
ONEDRIVE_CLIENT_ID=your-onedrive-client-id
