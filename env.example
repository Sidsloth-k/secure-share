# Environment Mode (production or development)
# - development: Uses file-based session storage, no encryption by default
# - production: Uses database session storage, encryption enabled by default
ENVIRONMENT=development

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Session Storage Mode
# - development: File-based storage (~/.secure_share/session.json)
# - production: Database storage (user_sessions table)
# Auto-selected based on ENVIRONMENT, but can be overridden
# USE_DATABASE_STORAGE=true

# Async/Await Support
# Set to true to enable async/await mode for high-concurrency scenarios
# When enabled, use auth.get_async_auth() to get AsyncAuth instance
USE_ASYNC_AUTH=false

# Session Security
# Set to true to enable session encryption at rest
# Recommended for production, optional for development
ENABLE_SESSION_ENCRYPTION=false
# Optional: Custom encryption key (base64 url-safe encoded, 32 bytes)
# Generate with: python -c "from cryptography.fernet import Fernet; import base64; print(base64.urlsafe_b64encode(Fernet.generate_key()).decode())"
# If not set, uses OS keyring or machine-specific key
SESSION_ENCRYPTION_KEY=

# Token Refresh Metrics
# Set to true to enable token refresh metrics tracking
# Recommended for production monitoring
ENABLE_REFRESH_METRICS=false

# Database Configuration (for migrations)
# Option 1: Direct PostgreSQL connection string
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Option 2: Individual database credentials (alternative to DATABASE_URL)
DATABASE_HOST=db.your-project.supabase.co
DATABASE_PASSWORD=your-database-password

# S3-Compatible Storage Configuration (Supabase Storage)
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
S3_REGION=eu-north-1

# Google Drive OAuth (optional, for cloud storage)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080

# Dropbox OAuth (optional, for cloud storage)
DROPBOX_APP_KEY=your-dropbox-app-key
DROPBOX_APP_SECRET=your-dropbox-app-secret

# OneDrive OAuth (optional, for cloud storage)
ONEDRIVE_CLIENT_ID=your-onedrive-client-id
ONEDRIVE_REDIRECT_URI=http://localhost:8080

# Shared OAuth defaults
DEFAULT_REDIRECT_URI=http://localhost:8080
